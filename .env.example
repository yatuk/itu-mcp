# Copy this file to .env and fill in your own ITU credentials.
# Public OBS/campus/library-catalog tools work without these values.
# Never commit your real .env file.
#
# Which file is read:
#   - NINOVA_ENV_FILE=/absolute/path/to/file, set in the process environment, or
#   - otherwise the .env in the directory the server is started from.
#     Parent directories are not searched.
# A variable already set in the process environment always wins.
#
# Lines marked [explicit] are security-relevant. They are ignored in a .env
# that was only found in the working directory. Set them in the process
# environment (the "env" block of your MCP client), or point NINOVA_ENV_FILE
# at this file. Ignored keys are named on stderr at startup.

# Easier alternative to this file: pipx install "itu-mcp[keyring]", then
# `itu-mcp setup` stores both values in the operating system keychain.
# Values set here or in the process environment win over the keychain.
NINOVA_USERNAME=your_itu_username
NINOVA_PASSWORD=your_itu_password
# 0 = never read the OS keychain. A .env may switch it off, not back on.
# NINOVA_KEYRING=1

# Optional separate İTÜ Mail credentials; shared credentials are used if omitted.
# NINOVA_MAIL_USERNAME=your_itu_email
# NINOVA_MAIL_PASSWORD=your_itu_mail_password
# [explicit] NINOVA_MAIL_SENT_MAILBOX=Sent Items  # existing folder if discovery is ambiguous
# Only imap.itu.edu.tr on port 993 is accepted; any other value is refused.
# [explicit] NINOVA_MAIL_HOST=imap.itu.edu.tr
# [explicit] NINOVA_MAIL_PORT=993
# NINOVA_MAIL_TIMEOUT_SECONDS=15

# Optional tuning (Phase A defaults shown)
# [explicit] NINOVA_BASE_URL=https://ninova.itu.edu.tr
# [explicit] NINOVA_STATE_DIR=
# NINOVA_ENV_FILE is read from the process environment only, never from a file.
# NINOVA_COURSE_CACHE_TTL_SECONDS=60
# NINOVA_TRACKING_MAX_AGE_SECONDS=43200
# NINOVA_REQUEST_DELAY_MS=120
# NINOVA_DISABLE_PLAYWRIGHT_FALLBACK=0
# NINOVA_COMPACT_DEFAULT=0
# 0 = disable assignment uploads. A .env may switch uploads off, not back on.
# NINOVA_ALLOW_UPLOADS=1
# 1/true/yes/on = refuse assignment uploads and draft saves unless the MCP client can ask the user (elicitation).
# A .env may switch this on, not off.
# NINOVA_REQUIRE_ELICITATION=0
#
# The five settings below are ignored in a .env found in the working directory.
# Set them in the process environment or in the file NINOVA_ENV_FILE points at.
# 1 = let include_sensitive=true return national ID, phone, address and names unredacted.
# NINOVA_ALLOW_SENSITIVE_OUTPUT=0
# Extra absolute directories read_resource_text may read (; on Windows, : elsewhere).
# NINOVA_EXTRA_READ_DIRS=
# Extra absolute directories download_resource and obs_download_transcript may write to.
# NINOVA_EXTRA_DOWNLOAD_DIRS=
# NINOVA_MAX_DOWNLOAD_MB=200
# Extra exact *.itu.edu.tr hosts the login redirect chain may pass through (comma separated).
# NINOVA_EXTRA_SSO_HOSTS=
# NINOVA_SESSION_PERSIST=1
# NINOVA_SESSION_MAX_AGE_SECONDS=43200
#
# Tool groups (local and remote). Default: every group on. "core" is always on.
# Groups: core, ninova, files, obs, registration, portal, planning,
# public, campus, library, archive, mail. An unknown name stops the server at startup.
# See the table with: itu-mcp --list-toolsets
# NINOVA_TOOLSETS=ninova,obs,archive
# NINOVA_DISABLED_TOOLSETS=library,mail
#
# OBS (student portal)
# Saving a registration draft is disabled by default. Does not enroll or drop courses.
# [explicit] NINOVA_OBS_REGISTRATION_WRITES=1
# [explicit] NINOVA_OBS_BASE_URL=https://obs.itu.edu.tr
# Only for accounts with more than one student record (transfer, double major): the
# student number OBS should open. Without it the single active record is used.
# NINOVA_OBS_STUDENT_NUMBER=
# NINOVA_OBS_JWT_TTL_SECONDS=1500
# NINOVA_OBS_PUBLIC_CACHE_TTL_SECONDS=3600
# NINOVA_PUBLIC_SCHEDULE_CACHE_TTL_SECONDS=60
# NINOVA_ITU_PUBLIC_CACHE_TTL_SECONDS=300
#
# Legacy WebPAC account compatibility only; current Sirsi account tools are unsupported.
# Public catalog search does not need account credentials.
# NINOVA_LIBRARY_NAME=Surname, Name
# NINOVA_LIBRARY_ID=student_number
# NINOVA_LIBRARY_PIN=separate_library_pin
# NINOVA_LIBRARY_CACHE_TTL_SECONDS=300
# Moodle uses the same NINOVA_USERNAME/NINOVA_PASSWORD. Cache lifetimes in seconds:
# NINOVA_MOODLE_CACHE_TTL_SECONDS=120
# NINOVA_POOL_CACHE_TTL_SECONDS=600
# [explicit] NINOVA_LIBRARY_CA_BUNDLE=
# Optional existing loopback HTTP CONNECT proxy, modern public Sirsi only.
# Literal 127.0.0.1 or [::1], explicit port 1024..65535; no credentials/path/query.
# [explicit] NINOVA_LIBRARY_PROXY_URL=http://127.0.0.1:18888
#
# Remote HTTP only (itu-mcp-remote). See docs/advanced.md for the startup rules.
# NINOVA_REMOTE_HOST=127.0.0.1
# Required when the bind host is not loopback. On loopback with no key, a random
# one-time key is generated and printed at startup. Not read from a .env found in
# the working directory: set it in the process environment or via NINOVA_ENV_FILE.
# NINOVA_REMOTE_API_KEY=
# 1 = refuse to start without NINOVA_REMOTE_API_KEY on any bind (no generated key).
# NINOVA_REMOTE_REQUIRE_API_KEY=0
# Expected Host header values. One of these two is required when the bind host is not loopback.
# NINOVA_ALLOWED_HOSTS=itu-mcp.example.com
# NINOVA_PUBLIC_BASE_URL=https://itu-mcp.example.com
# NINOVA_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
# Default /mcp. Must not be empty, "/" or /healthz.
# NINOVA_REMOTE_MCP_PATH=/mcp
# NINOVA_REMOTE_RATE_LIMIT=60
# NINOVA_REMOTE_RATE_WINDOW_SECONDS=60
# NINOVA_REMOTE_DISABLE_RATE_LIMIT=0
# Only behind a real reverse proxy: read the client address from X-Forwarded-For,
# counted from the right, skipping this many trusted proxies.
# NINOVA_REMOTE_TRUST_PROXY_HEADERS=0
# NINOVA_REMOTE_TRUSTED_PROXY_HOPS=1
# 1 = /healthz also reports whether login works (cached for the given seconds).
# NINOVA_HEALTHZ_CHECK_AUTH=0
# NINOVA_HEALTHZ_AUTH_CACHE_SECONDS=60
# Dangerous opt-outs, each prints a warning at startup. Leave them unset.
# NINOVA_REMOTE_ALLOW_UNAUTHENTICATED=0
# NINOVA_DISABLE_DNS_REBINDING_PROTECTION=0
# NINOVA_REMOTE_ENABLE_MAIL=0
# NINOVA_REMOTE_ALLOWED_TOOLS=
#
# The four variables below are read from the process environment only. They
# do not start with NINOVA_, so they are never loaded from any .env file.
# İTÜ ders arşivi (public, kimlik gerekmez):
# ITU_ARCHIVE_BASE_URL=https://itu-ders.com/data
# ITU_ARCHIVE_CACHE_TTL_SECONDS=21600
# Üçüncü taraf topluluk önşart çapraz doğrulama kaynağı (public, kimlik gerekmez):
# PREREQ_CROSSCHECK_BASE_URL=<community pipe-delimited course feed URL>
# PREREQ_CROSSCHECK_CACHE_TTL_SECONDS=21600
