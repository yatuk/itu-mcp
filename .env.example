# Copy this file to .env and fill in your own ITU credentials.
# Public OBS/campus/library-catalog tools work without these values.
# Never commit your real .env file.

NINOVA_USERNAME=your_itu_username
NINOVA_PASSWORD=your_itu_password

# Optional tuning (Phase A defaults shown)
# NINOVA_BASE_URL=https://ninova.itu.edu.tr
# NINOVA_STATE_DIR=
# NINOVA_ENV_FILE=
# NINOVA_COURSE_CACHE_TTL_SECONDS=60
# NINOVA_REQUEST_DELAY_MS=120
# NINOVA_DISABLE_PLAYWRIGHT_FALLBACK=0
# NINOVA_COMPACT_DEFAULT=0
# NINOVA_ALLOW_UPLOADS=1
# NINOVA_SESSION_PERSIST=1
# NINOVA_SESSION_MAX_AGE_SECONDS=43200
#
# OBS (student portal)
# NINOVA_OBS_BASE_URL=https://obs.itu.edu.tr
# NINOVA_OBS_JWT_TTL_SECONDS=1500
# NINOVA_OBS_PUBLIC_CACHE_TTL_SECONDS=3600
# NINOVA_PUBLIC_SCHEDULE_CACHE_TTL_SECONDS=60
# NINOVA_ITU_PUBLIC_CACHE_TTL_SECONDS=300
#
# Library account (catalog search does not need these)
# NINOVA_LIBRARY_NAME=Surname, Name
# NINOVA_LIBRARY_ID=student_number
# NINOVA_LIBRARY_PIN=separate_library_pin
# NINOVA_LIBRARY_CACHE_TTL_SECONDS=300
# NINOVA_LIBRARY_CA_BUNDLE=
#
# Remote HTTP only:
# NINOVA_REMOTE_HOST=127.0.0.1
# NINOVA_REMOTE_API_KEY=
# NINOVA_REMOTE_REQUIRE_API_KEY=0
# NINOVA_REMOTE_RATE_LIMIT=60
# NINOVA_REMOTE_RATE_WINDOW_SECONDS=60
